# Пример Nginx для «Бухгалтер-ниндзя»
# Замените YOUR_DOMAIN и YOUR_PROJECT_PATH.
# Не копируйте этот файл как есть без правок.
#
# HTTPS обязателен для VK Mini Apps.
# Не ставьте X-Frame-Options: DENY — приложение открывается
# во iframe / WebView ВКонтакте.

# HTTP → HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name YOUR_DOMAIN;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name YOUR_DOMAIN;

    ssl_certificate     /etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem;

    server_tokens off;
    add_header Strict-Transport-Security "max-age=15552000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://vk.com https://*.vk.com https://vk.ru https://*.vk.ru; connect-src 'self' https: https://vk.com https://*.vk.com https://vk.ru https://*.vk.ru; img-src 'self' data: blob: https://vk.com https://*.vk.com https://vk.ru https://*.vk.ru https://*.userapi.com; style-src 'self' 'unsafe-inline'; font-src 'self'; media-src 'self' blob:; frame-ancestors https://vk.com https://*.vk.com https://vk.ru https://*.vk.ru https://ok.ru https://*.ok.ru; base-uri 'self'; form-action 'self'" always;

    root YOUR_PROJECT_PATH;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location = /index.html {
        add_header Cache-Control "no-store";
    }

    location = / {
        add_header Cache-Control "no-store";
        try_files /index.html =404;
    }

    location ~* \.(js|css|webp|png|svg|woff2?)$ {
        expires 7d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header X-Powered-By;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
