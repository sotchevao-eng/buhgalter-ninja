# Backend ENV template. Copy to server/.env and fill locally.
# Never commit a filled .env. Never put secrets in js/runtime-config.js.

# required in production: NODE_ENV, DATABASE_URL, CORS_ORIGIN, SESSION_SECRET
# optional for browser-only play: VK_*, FRONTEND_URL, API_PUBLIC_URL
# VK_APP_SECRET is required for VK Mini Apps auth (HMAC-SHA256 of launch params).

NODE_ENV=development
PORT=3001

DATABASE_URL=postgres://ninja:ninja@localhost:5432/accountant_ninja

FRONTEND_URL=
API_PUBLIC_URL=
CORS_ORIGIN=http://localhost:8080

VK_APP_ID=
VK_GROUP_ID=
VK_APP_SECRET=
VK_COMMUNITY_URL=

SESSION_SECRET=
SESSION_TTL_DAYS=30

LEADERBOARD_TIMEZONE=Europe/Moscow
WEEK_START=monday

MAINTENANCE_MODE=false
